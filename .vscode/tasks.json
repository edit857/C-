{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: gcc 编译当前文件",
            "type": "shell",
            "command": "D:\\Tools\\VSCode\\w64devkit\\bin\\gcc.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-Wall",
                "-g",
                "-std=c17"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "C++: g++ 编译当前文件",
            "type": "shell",
            "command": "D:\\Tools\\VSCode\\w64devkit\\bin\\g++.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-Wall",
                "-g",
                "-std=c++17"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "C/C++: 编译并运行当前文件",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "gcc \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -Wall -g -std=c17 && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
